# Variables de entorno para FacturaPro

# Seguridad
SECRET_KEY=facturapro_super_secret_key_2025_alanube_integration

# Base de datos (Producción)
DATABASE_URL=postgresql://user:password@host:port/database

# Base de datos (Desarrollo - descomenta para desarrollo local)
# DATABASE_URL=sqlite:///./invoices.db

# Alanube Integration
ALANUBE_KEY=TU_API_KEY_DE_PRUEBA
ALANUBE_API_URL=https://api.alanube.co
ALANUBE_SANDBOX=false

# Frontend URL (para CORS)
FRONTEND_URL=https://facturapro.vercel.app

# Para desarrollo local, cambiar FRONTEND_URL a:
# FRONTEND_URL=http://localhost:3000
